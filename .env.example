# AI Training Marketplace Desktop Application - Environment Configuration
# =============================================================================
# 
# This file contains environment variables for local development and testing.
# Copy this file to .env and update the values with your actual credentials.
# 
# SECURITY WARNING: Never commit the actual .env file to version control!
# The .env file should be added to .gitignore to prevent accidental exposure.
# =============================================================================

# JWT Authentication Configuration
# ================================
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION!
# Use a strong, randomly generated secret (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars

# OAuth2 Google Configuration (Optional)
# ======================================
# To enable Google OAuth2 login, create a Google Cloud Console project:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
# 5. Add redirect URI: http://localhost:1420/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id-from-console
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-console

# OAuth2 GitHub Configuration (Optional)
# ======================================
# To enable GitHub OAuth2 login, create a GitHub OAuth App:
# 1. Go to https://github.com/settings/developers
# 2. Create a new OAuth App
# 3. Set Authorization callback URL: http://localhost:1420/auth/callback
GITHUB_CLIENT_ID=your-github-client-id-from-settings
GITHUB_CLIENT_SECRET=your-github-client-secret-from-settings

# OAuth2 Redirect Configuration
# =============================
# The URL where OAuth2 providers will redirect after authentication
# For development, this should match your local development server
OAUTH_REDIRECT_URL=http://localhost:1420/auth/callback

# Application Configuration
# =========================
# Application environment (development, staging, production)
APP_ENV=development

# Logging Configuration
# ====================
# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Enable/disable debug mode
DEBUG=true

# Database Configuration (Optional - for future use)
# ==================================================
# SQLite database file path (relative to project root)
DATABASE_URL=./data/app.db

# Redis connection URL (optional - for caching and sessions)
REDIS_URL=redis://localhost:6379

# Network Configuration
# =====================
# Port for the frontend development server
FRONTEND_PORT=1420

# Port for the Tauri application (auto-assigned)
TAURI_PORT=auto

# Security Configuration
# ======================
# Enable/disable additional security features
ENABLE_RATE_LIMITING=false
ENABLE_AUDIT_LOGGING=true

# Session configuration
SESSION_TIMEOUT_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Development Settings
# ===================
# Enable hot reload for development
HOT_RELOAD=true

# Enable development tools
DEV_TOOLS=true

# Skip OAuth2 setup warnings in development
SKIP_OAUTH_WARNINGS=false

# =============================================================================
# SETUP INSTRUCTIONS FOR LOCAL DEVELOPMENT:
# =============================================================================
# 
# 1. Copy this file to .env in the project root
# 2. Generate a strong JWT secret (32+ characters)
# 3. (Optional) Set up Google OAuth2:
#    - Create project at https://console.cloud.google.com/
#    - Enable Google+ API
#    - Create OAuth 2.0 credentials
#    - Set redirect URI: http://localhost:1420/auth/callback
# 4. (Optional) Set up GitHub OAuth2:
#    - Go to https://github.com/settings/developers
#    - Create new OAuth App
#    - Set callback URL: http://localhost:1420/auth/callback
# 5. Update other values as needed for your setup
# 
# =============================================================================
